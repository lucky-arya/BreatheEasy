# ===========================================
# BreatheEasy Environment Configuration
# ===========================================

# Node Environment
NODE_ENV=development

# Backend Server
PORT=5000
BACKEND_URL=http://localhost:5000

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/breatheeasy

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000

# OpenAQ API v3 (Required for data ingestion)
# Get your API key from https://explore.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@breatheeasy.com

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_MAPBOX_TOKEN=your_mapbox_access_token

# Cron Job Configuration
CRON_INGESTION_INTERVAL=*/10 * * * *
CRON_ENABLED=true

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Backend Environment Variables for Render
# Copy this to .env for local development

# MongoDB Atlas Connection String (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/breatheeasy

# OpenAQ API Key (Required for data ingestion)
OPENAQ_API_KEY=your_openaq_api_key

# ML Service URL (Will be auto-set by Render Blueprint)
ML_SERVICE_URL=http://localhost:8000

# JWT Secret (Auto-generated by Render)
JWT_SECRET=your_jwt_secret_key

# Server Port
PORT=5000

# Environment
NODE_ENV=production

# Frontend URL for CORS (Will be auto-set by Render)
FRONTEND_URL=http://localhost:3000
